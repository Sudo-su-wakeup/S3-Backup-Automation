{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ObjectAccessInBackupsFolder",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::manish-backup-lab-2026/backups/*"
    },
    {
      "Sid": "ListTheBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::manish-backup-lab-2026"
    }
  ]
}
